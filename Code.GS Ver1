// =======================================================
// INITIALIZATION / DATABASE SETUP FUNCTION
// =======================================================
function setupDatabaseSheets() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  
  const sheetsToCreate = [
    {
      name: "Assessments",
      headers: [
        "Assessment_ID", "Lead_ID", "Assessment_Date", "Assessment_Time", "Company_Name", 
        "Consultants", "Biz_Type", "Biz_Sector", "Company_Type", "The_Team_Description",
        "Count_Management", "Count_TopLine", "Count_MidLine", "Count_BottomLine", "Count_Labor",
        "Why_This_Up", "Mode_Of_Assessment", "Assessment_Type", "Assessment_Summary", 
        "Methodology_Approach", "Strengths", "Weaknesses", "Opportunities", "Challenges", 
        "KRA_KPA_Scores_JSON", "Recommendations", "Created_At"
      ]
    },
    {
      name: "SWOC_Mapping",
      headers: ["Area", "Category", "KPI", "Consequence"]
    },
    {
      name: "KRA vs KPA",
      headers: ["Department", "Checkpoint_ID", "Checkpoint_Text"]
    }
  ];

  sheetsToCreate.forEach(s => {
    let sheet = ss.getSheetByName(s.name);
    if (!sheet) {
      sheet = ss.insertSheet(s.name);
    }
    if (sheet.getLastRow() === 0) {
      sheet.appendRow(s.headers);
      sheet.getRange(1, 1, 1, s.headers.length).setFontWeight("bold");
    }
  });

  SpreadsheetApp.getUi().alert("Database Sheets Checked / Initialized Successfully!");
}

// =======================================================
// WEB APP API ENDPOINTS (doPost / doGet)
// =======================================================
function doPost(e) {
  try {
    const requestData = JSON.parse(e.postData.contents);
    const action = requestData.action;

    if (action === "getConsultantInitialData") {
      return jsonResponse(getConsultantInitialData());
    }
    
    if (action === "getDepartmentCheckpoints") {
      return jsonResponse(getDepartmentCheckpoints(requestData.department));
    }

    if (action === "submitConsultantAssessment") {
      return jsonResponse(submitConsultantAssessment(requestData.formData));
    }

    return jsonResponse({ success: false, error: "Invalid action" });
  } catch (err) {
    return jsonResponse({ success: false, error: err.toString() });
  }
}

function jsonResponse(data) {
  return ContentService.createTextOutput(JSON.stringify(data))
    .setMimeType(ContentService.MimeType.JSON);
}

// =======================================================
// HELPER FUNCTIONS
// =======================================================
function getConsultantInitialData() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  
  // 1. Read SWOC_Mapping Sheet
  const swocSheet = ss.getSheetByName("SWOC_Mapping");
  const strengths = new Set();
  const weaknesses = new Set();

  if (swocSheet && swocSheet.getLastRow() > 1) {
    const swocRows = swocSheet.getRange(2, 1, swocSheet.getLastRow() - 1, swocSheet.getLastColumn()).getValues();
    swocRows.forEach(row => {
      // Assuming Category is Col B (index 1) and KPI/Text is Col C (index 2)
      const category = (row[1] || "").toString().trim().toLowerCase();
      const itemText = (row[2] || "").toString().trim();
      
      if (itemText) {
        if (category === "strength") strengths.add(itemText);
        if (category === "weakness") weaknesses.add(itemText);
      }
    });
  }

  // 2. Read KRA vs KPA Sheet for Department list
  const kraSheet = ss.getSheetByName("KRA vs KPA");
  const departments = new Set();

  if (kraSheet && kraSheet.getLastRow() > 1) {
    const kraRows = kraSheet.getRange(2, 1, kraSheet.getLastRow() - 1, 1).getValues();
    kraRows.forEach(row => {
      const dept = (row[0] || "").toString().trim();
      if (dept) departments.add(dept);
    });
  }

  return {
    success: true,
    strengthsOptions: Array.from(strengths),
    weaknessesOptions: Array.from(weaknesses),
    departments: Array.from(departments)
  };
}

function getDepartmentCheckpoints(department) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const kraSheet = ss.getSheetByName("KRA vs KPA");
  
  if (!kraSheet || kraSheet.getLastRow() <= 1) {
    return { success: true, checkpoints: [] };
  }

  const kraRows = kraSheet.getRange(2, 1, kraSheet.getLastRow() - 1, Math.max(kraSheet.getLastColumn(), 3)).getValues();

  const checkpoints = kraRows
    .filter(r => (r[0] || "").toString().trim() === department)
    .map((r, idx) => ({
      id: r[1] ? r[1].toString().trim() : "CP-" + (idx + 1),
      text: r[2] ? r[2].toString().trim() : r[1] // fallback if ID column varies
    }));

  return { success: true, checkpoints: checkpoints };
}

function submitConsultantAssessment(data) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName("Assessments");

  if (!sheet) {
    sheet = ss.insertSheet("Assessments");
  }

  const newId = "ASS-" + new Date().getTime();

  sheet.appendRow([
    newId,
    data.leadId || "",
    data.date || "",
    data.time || "",
    data.companyName || "",
    (data.consultants || []).join(", "),
    data.bizType || "",
    data.bizSector || "",
    data.companyType || "",
    data.teamDescription || "",
    data.countMgmt || 0,
    data.countTop || 0,
    data.countMid || 0,
    data.countBottom || 0,
    data.countLabor || 0,
    data.whyThisUp || "",
    data.mode || "",
    data.assType || "",
    data.summary || "",
    data.methodology || "",
    (data.strengths || []).join("; "),
    (data.weaknesses || []).join("; "),
    data.opportunities || "",
    data.challenges || "",
    JSON.stringify(data.kraScores || {}),
    data.recommendations || "",
    new Date()
  ]);

  return { success: true, assessmentId: newId };
}
