// =======================================================
// INITIALIZATION / SETUP FUNCTION
// =======================================================
function setupDatabaseSheets() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  
  const sheetsToCreate = [
    {
      name: "Assessments",
      headers: [
        "Assessment_ID", "Lead_ID", "Assessment_Date", "Assessment_Time", "Company_Name", 
        "Consultants", "Biz_Type", "Biz_Sector", "Company_Type", "The_Team_Description",
        "Count_Management", "Count_TopLine", "Count_MidLine", "Count_BottomLine", "Count_Labor",
        "Why_This_Up", "Mode_Of_Assessment", "Assessment_Type", "Assessment_Summary", 
        "Methodology_Approach", "Strengths", "Weaknesses", "Opportunities", "Challenges", 
        "KRA_KPA_Scores_JSON", "Recommendations", "Created_At"
      ]
    },
    {
      name: "SWOC_Master",
      headers: ["ID", "Category", "Item_Text"]
    },
    {
      name: "KRA_Checkpoints_Master",
      headers: ["Department", "Checkpoint_ID", "Checkpoint_Text"]
    }
  ];

  sheetsToCreate.forEach(s => {
    let sheet = ss.getSheetByName(s.name);
    if (!sheet) {
      sheet = ss.insertSheet(s.name);
    }
    if (sheet.getLastRow() === 0) {
      sheet.appendRow(s.headers);
      sheet.getRange(1, 1, 1, s.headers.length).setFontWeight("bold");
    }
  });

  // Populate sample SWOC data if empty
  const swocSheet = ss.getSheetByName("SWOC_Master");
  if (swocSheet.getLastRow() <= 1) {
    swocSheet.appendRow(["1", "Strength", "Strong Brand Reputation"]);
    swocSheet.appendRow(["2", "Strength", "High Employee Retention"]);
    swocSheet.appendRow(["3", "Weakness", "Outdated Software Systems"]);
    swocSheet.appendRow(["4", "Weakness", "High Operational Overhead"]);
  }

  // Populate sample KRA/KPA Checkpoints if empty
  const kraSheet = ss.getSheetByName("KRA_Checkpoints_Master");
  if (kraSheet.getLastRow() <= 1) {
    kraSheet.appendRow(["Management", "MGT-01", "Strategic Vision & Goal Alignment"]);
    kraSheet.appendRow(["Management", "MGT-02", "Organizational Hierarchy & Delegation"]);
    kraSheet.appendRow(["Marketing", "MKT-01", "Lead Generation Efficiency"]);
    kraSheet.appendRow(["Marketing", "MKT-02", "Brand Consistency Across Channels"]);
    kraSheet.appendRow(["HR", "HR-01", "Onboarding & Training Process"]);
    kraSheet.appendRow(["HR", "HR-02", "Performance Management System (PMS)"]);
  }

  SpreadsheetApp.getUi().alert("Database Setup Completed Successfully!");
}

// =======================================================
// WEB APP API ENDPOINTS (doPost / doGet)
// =======================================================
function doPost(e) {
  try {
    const requestData = JSON.parse(e.postData.contents);
    const action = requestData.action;

    if (action === "getConsultantInitialData") {
      return jsonResponse(getConsultantInitialData(requestData.consultantName));
    }
    
    if (action === "getDepartmentCheckpoints") {
      return jsonResponse(getDepartmentCheckpoints(requestData.department));
    }

    if (action === "submitConsultantAssessment") {
      return jsonResponse(submitConsultantAssessment(requestData.formData));
    }

    return jsonResponse({ success: false, error: "Invalid action" });
  } catch (err) {
    return jsonResponse({ success: false, error: err.toString() });
  }
}

function jsonResponse(data) {
  return ContentService.createTextOutput(JSON.stringify(data))
    .setMimeType(ContentService.MimeType.JSON);
}

// =======================================================
// HELPER FUNCTIONS
// =======================================================
function getConsultantInitialData(consultantName) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  
  // SWOC Options
  const swocSheet = ss.getSheetByName("SWOC_Master");
  const swocRows = swocSheet.getRange(2, 1, Math.max(swocSheet.getLastRow() - 1, 1), 3).getValues();
  const strengths = [];
  const weaknesses = [];

  swocRows.forEach(row => {
    if (row[1] === "Strength") strengths.push(row[2]);
    if (row[1] === "Weakness") weaknesses.push(row[2]);
  });

  // Department List for KRA/KPA
  const kraSheet = ss.getSheetByName("KRA_Checkpoints_Master");
  const kraRows = kraSheet.getRange(2, 1, Math.max(kraSheet.getLastRow() - 1, 1), 3).getValues();
  const departments = [...new Set(kraRows.map(r => r[0]).filter(Boolean))];

  return {
    success: true,
    strengthsOptions: strengths,
    weaknessesOptions: weaknesses,
    departments: departments
  };
}

function getDepartmentCheckpoints(department) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const kraSheet = ss.getSheetByName("KRA_Checkpoints_Master");
  const kraRows = kraSheet.getRange(2, 1, Math.max(kraSheet.getLastRow() - 1, 1), 3).getValues();

  const checkpoints = kraRows
    .filter(r => r[0] === department)
    .map(r => ({ id: r[1], text: r[2] }));

  return { success: true, checkpoints: checkpoints };
}

function submitConsultantAssessment(data) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("Assessments");

  const newId = "ASS-" + new Date().getTime();

  sheet.appendRow([
    newId,
    data.leadId || "",
    data.date || "",
    data.time || "",
    data.companyName || "",
    data.consultant || "",
    data.bizType || "",
    data.bizSector || "",
    data.companyType || "",
    data.teamDescription || "",
    data.countMgmt || 0,
    data.countTop || 0,
    data.countMid || 0,
    data.countBottom || 0,
    data.countLabor || 0,
    data.whyThisUp || "",
    data.mode || "",
    data.assType || "",
    data.summary || "",
    data.methodology || "",
    (data.strengths || []).join("; "),
    (data.weaknesses || []).join("; "),
    data.opportunities || "",
    data.challenges || "",
    JSON.stringify(data.kraScores || {}),
    data.recommendations || "",
    new Date()
  ]);

  return { success: true, assessmentId: newId };
}
